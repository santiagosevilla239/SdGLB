{
  "name": "los-bambinos-desktop",
  "version": "1.0.0",
  "description": "App de escritorio de Los Bambinos (Wrapper Vercel)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.losbambinos.desktop",
    "productName": "Los Bambinos",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/serialport/**/*",
      "**/node_modules/@serialport/**/*"
    ]
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "serialport": "^12.0.0"
  }
}
